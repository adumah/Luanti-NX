+#ifdef __SWITCH__
+void GUIFormSpecMenu::onSwitchTextEdited(gui::IGUIElement *box, const std::string &field_name)
+{
+	// Same as Android: fields with "enter after edit" (e.g. search boxes)
+	// get an Enter event once the text was entered.
+	auto iter = field_enter_after_edit.find(field_name);
+	if (iter == field_enter_after_edit.end() || !iter->second || !box->getParent())
+		return;
+	SEvent enter{};
+	enter.EventType = EET_GUI_EVENT;
+	enter.GUIEvent.Caller = box;
+	enter.GUIEvent.Element = nullptr;
+	enter.GUIEvent.EventType = gui::EGET_EDITBOX_ENTER;
+	box->getParent()->OnEvent(enter);
+}
+#endif
