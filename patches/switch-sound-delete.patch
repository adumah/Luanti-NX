+#ifdef __SWITCH__
+// List a directory completely before deleting its entries (not while its handle
+// is open, as remove_all does), and report the exact entry that fails.
+static bool switch_remove_tree(const std::filesystem::path &p)
+{
+	std::error_code ec;
+	bool ok = true;
+	if (std::filesystem::symlink_status(p, ec).type() == std::filesystem::file_type::directory) {
+		std::vector<std::filesystem::path> children;
+		for (std::filesystem::directory_iterator it(p, ec), end; !ec && it != end; it.increment(ec))
+			children.push_back(it->path());
+		if (ec) {
+			errorstream << "RecursiveDelete: Failed to list \"" << p.string()
+					<< "\": " << ec.message() << std::endl;
+			return false;
+		}
+		for (const auto &child : children)
+			ok &= switch_remove_tree(child);
+	}
+	if (!ok)
+		return false;
+	std::filesystem::remove(p, ec);
+	if (ec) {
+		errorstream << "RecursiveDelete: Failed to delete \"" << p.string()
+				<< "\": " << ec.message() << std::endl;
+		return false;
+	}
+	return true;
+}
+#endif
