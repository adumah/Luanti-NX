+static void drawSwitchPointer(video::IVideoDriver *driver, s32 x, s32 y)
+{
+	// Arrow pointer built from 1px rows: black outline, white fill.
+	const s32 h = core::max_<s32>(16, driver->getScreenSize().Height / 36);
+	const video::SColor black(255, 0, 0, 0), white(255, 255, 255, 255);
+	for (s32 r = 0; r <= h; r++)
+		driver->draw2DRectangle(black, core::recti(x, y + r, x + r * 5 / 8 + 2, y + r + 1));
+	for (s32 r = 2; r < h; r++)
+		driver->draw2DRectangle(white, core::recti(x + 1, y + r, x + r * 5 / 8, y + r + 1));
+}
+#endif
