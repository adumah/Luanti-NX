 //! runs the device. Returns false if device wants to be deleted
+#ifdef __SWITCH__
+// Read by CGUIEnvironment::drawAll(), which draws the pointer (SDL draws none here).
+bool g_switchPointerShown = false;
+s32 g_switchPointerX = 0, g_switchPointerY = 0;
+
+// While a menu shows the cursor: A (SDL "B", east) = left click, Y (SDL "X", west)
+// = right click, left stick moves the pointer, right stick scrolls. These inputs
+// are kept from the game meanwhile. Returns true if the event was consumed.
+bool CIrrDeviceSDL::switchPadPointerEvent(const SDL_Event &e)
+{
+	const bool visible = CursorControl && CursorControl->isVisible();
+
+	if (e.type == SDL_EVENT_GAMEPAD_AXIS_MOTION) {
+		if (e.caxis.axis > 3) // triggers stay with the game
+			return false;
+		PadPointerAxis[e.caxis.axis] = e.caxis.value / 32767.0f;
+		return visible;
+	}
+
+	const u8 b = e.cbutton.button;
+	if (b != SDL_CONTROLLER_BUTTON_B && b != SDL_CONTROLLER_BUTTON_X)
+		return false;
+	const bool left = b == SDL_CONTROLLER_BUTTON_B;
+	const u32 mask = SDL_BUTTON_MASK(left ? SDL_BUTTON_LEFT : SDL_BUTTON_RIGHT);
+	const bool down = e.type == SDL_EVENT_GAMEPAD_BUTTON_DOWN;
+	// Always deliver the release of a click we started, even if the menu closed.
+	if (!visible && (down || !(MouseButtonStates & mask)))
+		return false;
+
+	if (down)
+		MouseButtonStates |= mask;
+	else
+		MouseButtonStates &= ~mask;
+
+	SEvent ev{};
+	ev.EventType = EET_MOUSE_INPUT_EVENT;
+	ev.MouseInput.Button = left ? SDL_BUTTON_LEFT : SDL_BUTTON_RIGHT;
+	if (left)
+		ev.MouseInput.Event = down ? EMIE_LMOUSE_PRESSED_DOWN : EMIE_LMOUSE_LEFT_UP;
+	else
+		ev.MouseInput.Event = down ? EMIE_RMOUSE_PRESSED_DOWN : EMIE_RMOUSE_LEFT_UP;
+	ev.MouseInput.X = MouseX;
+	ev.MouseInput.Y = MouseY;
+	ev.MouseInput.ButtonStates = MouseButtonStates;
+	g_switchPointerShown = visible;
+	postEventFromUser(ev);
+
+	if (down) {
+		u32 clicks = checkSuccessiveClicks(MouseX, MouseY, ev.MouseInput.Event);
+		if (clicks == 2 || clicks == 3) {
+			s32 base = clicks == 2 ? EMIE_LMOUSE_DOUBLE_CLICK : EMIE_LMOUSE_TRIPLE_CLICK;
+			ev.MouseInput.Event = (EMOUSE_INPUT_EVENT)(base + ev.MouseInput.Event - EMIE_LMOUSE_PRESSED_DOWN);
+			postEventFromUser(ev);
+		}
+	}
+	return true;
+}
+
+void CIrrDeviceSDL::switchPadPointerUpdate()
+{
+	const bool visible = CursorControl && CursorControl->isVisible();
+	const u32 now = os::Timer::getRealTime();
+	f32 dt = (now - PadPointerLastTime) / 1000.0f;
+	PadPointerLastTime = now;
+	if (dt > 0.1f)
+		dt = 0.1f;
+
+	if (visible && !PadPointerWasVisible) {
+		// A menu opened: the game keeps the last stick values it saw, so zero
+		// them, or the player would keep walking/turning behind the menu.
+		for (int a = 0; a < 4; a++) {
+			SEvent ev{};
+			ev.EventType = EET_GAMEPAD_AXIS_EVENT;
+			ev.GamepadAxisEvent.ID = recentGamepadID;
+			ev.GamepadAxisEvent.Axis = static_cast<GamepadAxis>(a);
+			ev.GamepadAxisEvent.Value = 0;
+			postEventFromUser(ev);
+		}
+	}
+	PadPointerWasVisible = visible;
+	if (!visible) {
+		g_switchPointerShown = false;
+		return;
+	}
+
+	// Dead zone, then a quadratic curve for precise slow movement.
+	auto shape = [](f32 v) {
+		f32 m = v < 0 ? -v : v;
+		if (m < 0.2f)
+			return 0.0f;
+		m = (m - 0.2f) / 0.8f;
+		return v < 0 ? -m * m : m * m;
+	};
+
+	const f32 vx = shape(PadPointerAxis[0]), vy = shape(PadPointerAxis[1]);
+	if (vx != 0.0f || vy != 0.0f) {
+		if (!g_switchPointerShown) {
+			PadPointerFX = MouseX;
+			PadPointerFY = MouseY;
+		}
+		const f32 speed = Height * 1.3f; // screen heights per second at full tilt
+		PadPointerFX = core::clamp(PadPointerFX + vx * speed * dt, 0.0f, (f32)Width - 1);
+		PadPointerFY = core::clamp(PadPointerFY + vy * speed * dt, 0.0f, (f32)Height - 1);
+		MouseX = static_cast<s32>(PadPointerFX);
+		MouseY = static_cast<s32>(PadPointerFY);
+		g_switchPointerShown = true;
+
+		SEvent ev{};
+		ev.EventType = EET_MOUSE_INPUT_EVENT;
+		ev.MouseInput.Event = EMIE_MOUSE_MOVED;
+		ev.MouseInput.X = MouseX;
+		ev.MouseInput.Y = MouseY;
+		ev.MouseInput.ButtonStates = MouseButtonStates;
+		postEventFromUser(ev);
+	}
+
+	const f32 w = shape(PadPointerAxis[3]);
+	const f32 aw = w < 0 ? -w : w;
+	if (w != 0.0f && now - PadPointerLastWheel > (u32)(180 - 140 * aw)) {
+		PadPointerLastWheel = now;
+		g_switchPointerShown = true;
+		SEvent ev{};
+		ev.EventType = EET_MOUSE_INPUT_EVENT;
+		ev.MouseInput.Event = EMIE_MOUSE_WHEEL;
+		ev.MouseInput.Wheel = w < 0 ? 1.0f : -1.0f; // stick up = scroll up
+		ev.MouseInput.X = MouseX;
+		ev.MouseInput.Y = MouseY;
+		ev.MouseInput.ButtonStates = MouseButtonStates;
+		postEventFromUser(ev);
+	}
+
+	g_switchPointerX = MouseX;
+	g_switchPointerY = MouseY;
+}
+#endif
