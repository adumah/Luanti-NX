+/* Allocate a single contiguous dual-view JIT buffer sized to maxmcode. */
+static void mcode_allocarea(jit_State *J)
+{
+  Jit jit;
+  SwitchMCArea *area;
+  void *rw, *rx;
+  size_t sz;
+  if (J->mcarea)
+    lj_trace_err(J, LJ_TRERR_MCODEAL);
+  sz = (size_t)J->param[JIT_P_maxmcode] << 10;
+  sz = (sz + 0xfffu) & ~(size_t)0xfffu;
+  if (sz < 0x10000u) sz = 0x10000u;
+  if (R_FAILED(jitCreate(&jit, sz)))
+    lj_trace_err(J, LJ_TRERR_MCODEAL);
+  if (R_FAILED(jitTransitionToWritable(&jit))) {
+    jitClose(&jit);
+    lj_trace_err(J, LJ_TRERR_MCODEAL);
+  }
+  switch_relocate_rx_near(&jit, (uintptr_t)(void *)lj_vm_exit_handler);
+  rw = jitGetRwAddr(&jit);
+  rx = jitGetRxAddr(&jit);
+  J->mcdelta = (char *)rw - (char *)rx;
+  J->mcarea = (MCode *)rw;
+  J->szmcarea = sz;
+  J->mcprot = MCPROT_GEN;
+  J->mctop = (MCode *)((char *)rw + sz);
+  J->mcbot = (MCode *)((char *)rw + sizeof(SwitchMCArea));
+  area = (SwitchMCArea *)rw;
+  area->link.next = NULL;
+  area->link.size = sz;
+  area->jit = jit;
+  J->szallmcarea = sz;
+  J->mcbot = (MCode *)lj_err_register_mcode(rw, sz, (uint8_t *)J->mcbot, J->mcdelta);
+}
