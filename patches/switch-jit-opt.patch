+  MCode *mc = J->mcarea;
+  ptrdiff_t delta = J->mcdelta;
+  J->mcarea = NULL;
+  J->szallmcarea = 0;
+  J->mcdelta = 0;
+  if (mc) {
+    SwitchMCArea *area = (SwitchMCArea *)mc;
+    size_t sz = area->link.size;
+    Jit jit = area->jit;
+    lj_err_deregister_mcode(mc, sz, (uint8_t *)mc + sizeof(SwitchMCArea), delta);
+    jitClose(&jit);
+  }
+}
