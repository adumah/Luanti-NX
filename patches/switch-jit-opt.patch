@@ -52,6 +52,9 @@ void lj_mcode_sync(void *start, void *end)
   sys_icache_invalidate(start, (char *)end-(char *)start);
 #elif LJ_TARGET_PPC
   lj_vm_cachesync(start, end);
+#elif LJ_TARGET_SWITCH
+  /* Cache flush and invalidation happen in jitTransitionToExecutable(). */
+  UNUSED(start); UNUSED(end);
 #elif defined(__GNUC__) || defined(__clang__)
   __clear_cache(start, end);
 #else
@@ -162,6 +165,117 @@ static void mcode_setprot(jit_State *J, void *p, size_t sz, int prot)
 #endif
 }
 
+#elif LJ_TARGET_SWITCH
+
+#include <switch/result.h>
+#include <switch/arm/cache.h>
+#include <switch/kernel/jit.h>
+#include <switch/kernel/svc.h>
+
+#define MCPROT_RW	Perm_Rw
+#define MCPROT_RX	Perm_Rx
+#define MCPROT_RWX	Perm_Rx
+
+typedef struct SwitchMCArea {
+  MCLink link;
+  Jit jit;
+} SwitchMCArea;
+
+static void mcode_setprot(jit_State *J, void *p, size_t sz, int prot)
+{
+  SwitchMCArea *area = (SwitchMCArea *)p;
+  Result rc;
+  UNUSED(sz);
+  /* CodeMemory keeps both views mapped; sync only modified ranges instead. */
+  if (area->jit.type == JitType_CodeMemory)
+    return;
+  rc = (prot == MCPROT_RX) ? jitTransitionToExecutable(&area->jit)
+			   : jitTransitionToWritable(&area->jit);
+#if LUAJIT_SECURITY_MCODE != 0
+  if (R_FAILED(rc)) mcode_protfail(J);
+#else
+  UNUSED(J); UNUSED(rc);
+#endif
+}
+
+static void switch_dcache_clean_pou(void *addr, size_t size)
+{
+  uint64_t ctr, step;
+  uintptr_t p, end;
+  __asm__ __volatile__("mrs %0, ctr_el0" : "=r"(ctr));
+  step = (uint64_t)4u << ((ctr >> 16) & 0xfu);
+  p = (uintptr_t)addr & ~(uintptr_t)(step - 1u);
+  end = (uintptr_t)addr + size;
+  for (; p < end; p += step)
+    __asm__ __volatile__("dc cvau, %0" :: "r"(p) : "memory");
+  __asm__ __volatile__("dsb ish" ::: "memory");
+}
+
+void lj_mcode_sync_rx(jit_State *J, void *start, void *end)
+{
+  SwitchMCArea *area = (SwitchMCArea *)J->mcarea;
+  if (area && area->jit.type == JitType_CodeMemory && end > start) {
+    size_t len = (size_t)((char *)end - (char *)start);
+    void *rw = (char *)start + J->mcdelta;
+    switch_dcache_clean_pou(rw, len);
+    armICacheInvalidate(start, len);
+  }
